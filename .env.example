# Optional. Leave empty to use browser-local editing without Claude.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
PORT=3001
# Local default. The Render container sets HOST=0.0.0.0.
HOST=127.0.0.1
# Set only for a custom hosted domain. Render's onrender.com origin is detected automatically.
PUBLIC_ORIGIN=
