{
  "name": "pencil-slides",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "postinstall": "node scripts/assets.mjs",
    "dev": "concurrently -k \"tsx watch --env-file-if-exists=.env server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "vue-tsc --noEmit && vite build",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@fastify/static": "^8.3.0",
    "@open-pencil/core": "0.15.0",
    "@open-pencil/scene-graph": "0.15.0",
    "@open-pencil/vue": "0.15.0",
    "canvaskit-wasm": "0.41.1",
    "fastify": "^5.6.0",
    "pptxgenjs": "4.0.1",
    "vue": "^3.5.41",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "concurrently": "^9.2.0",
    "fflate": "^0.8.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vue-tsc": "^3.1.0"
  }
}
